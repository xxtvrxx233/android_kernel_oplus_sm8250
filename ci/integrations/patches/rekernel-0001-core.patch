diff --git a/include/linux/rekernel.h b/include/linux/rekernel.h
new file mode 100644
--- /dev/null
+++ b/include/linux/rekernel.h
@@ -0,0 +1,32 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _LINUX_REKERNEL_H
+#define _LINUX_REKERNEL_H
+
+#include <linux/errno.h>
+#include <linux/types.h>
+#include <linux/sched.h>
+
+#define REKERNEL_NETLINK_MIN		22
+#define REKERNEL_NETLINK_MAX		26
+#define REKERNEL_USER_PORT		100
+#define REKERNEL_PACKET_SIZE		128
+#define REKERNEL_MIN_USERAPP_UID	10000
+#define REKERNEL_MAX_SYSTEM_UID		2000
+#define REKERNEL_RESERVE_ORDER		17
+#define REKERNEL_WARN_AHEAD_SPACE	(1 << REKERNEL_RESERVE_ORDER)
+
+#ifdef CONFIG_REKERNEL
+
+int rekernel_start_server(void);
+int rekernel_send_message(const char *msg, uint16_t len);
+bool rekernel_line_is_frozen(struct task_struct *task);
+
+#else /* !CONFIG_REKERNEL */
+
+static inline int rekernel_start_server(void) { return -ENODEV; }
+static inline int rekernel_send_message(const char *msg, uint16_t len) { return -ENODEV; }
+static inline bool rekernel_line_is_frozen(struct task_struct *task) { return false; }
+
+#endif /* CONFIG_REKERNEL */
+
+#endif /* _LINUX_REKERNEL_H */
diff --git a/drivers/rekernel/Kconfig b/drivers/rekernel/Kconfig
new file mode 100644
--- /dev/null
+++ b/drivers/rekernel/Kconfig
@@ -0,0 +1,10 @@
+config REKERNEL
+	bool "Re:Kernel support"
+	depends on NET
+	default n
+	help
+	  Re:Kernel netlink notification support for frozen task detection.
+	  When enabled, binder and signal paths report events to userspace
+	  through a netlink socket (unit 22..25, port 100).
+
+	  Say N unless you use the Re:Kernel userspace daemon.
